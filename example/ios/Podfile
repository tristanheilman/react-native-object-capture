ENV['RCT_NEW_ARCH_ENABLED'] = '1'

def node_require(script)
  # Resolve react_native_pods.rb with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, "17.0"
prepare_react_native_project!

setup_permissions([
  'Camera',
  'MediaLibrary',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ObjectCaptureExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 (pulled in by fmt/glog and other RN pods) enables a `consteval`
    # compile-time format-string check that Xcode 16.3+/26's stricter Clang
    # rejects ("call to consteval function ... is not a constant expression").
    # This version defines FMT_CONSTEVAL unconditionally (no external toggle),
    # so neutralize it directly in the vendored header — the check then runs at
    # runtime instead. Remove once React Native ships fmt >= 11.1, which fixes
    # the consteval path on this toolchain.
    Dir.glob(File.join(installer.sandbox.root.to_s, 'fmt', '**', 'base.h')).each do |header|
      contents = File.read(header)
      patched = contents.gsub("#  define FMT_CONSTEVAL consteval", "#  define FMT_CONSTEVAL")
      File.write(header, patched) if patched != contents
    end
  end
end
