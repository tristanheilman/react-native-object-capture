{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "../package.json",
        "../android/**",
        "!../android/build/**",
        "!../android/.gradle/**",
        "!../android/.cxx/**",
        "../src/**",
        "!../src/**/__tests__/**",
        "package.json",
        "src/**",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!android/app/.cxx/**",
        "!**/.DS_Store"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "../package.json",
        "../*.podspec",
        "../ios/**",
        "!../ios/build/**",
        "../src/**",
        "!../src/**/__tests__/**",
        "package.json",
        "src/**",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**",
        "!ios/**/xcuserdata/**",
        "!ios/.xcode.env.local",
        "!**/.DS_Store"
      ],
      "outputs": []
    }
  }
}
